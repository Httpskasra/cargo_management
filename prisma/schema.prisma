generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum RunsheetType {
  NDX
  SAPAPOST
}

enum ItemStatus {
  IN_TRANSIT
  DELIVERED
  RETURNED
  NORMAL
}

model User {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  passwordHash String
  role         UserRole @default(RIDER)
  active       Boolean  @default(true)
  riderId      Int?     @unique
  rider        Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  RIDER
}

model Rider {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  runsheets Runsheet[]
  user      User?
}

model Runsheet {
  id        Int           @id @default(autoincrement())
  riderId   Int
  type      RunsheetType
  createdAt DateTime      @default(now())
  rider     Rider         @relation(fields: [riderId], references: [id], onDelete: Cascade)
  items     RunsheetItem[]

  @@index([riderId, type])
}

model RunsheetItem {
  id           Int        @id @default(autoincrement())
  runsheetId   Int
  barcode      String     @unique
  status       ItemStatus @default(IN_TRANSIT)
  registeredAt DateTime   @default(now())
  deliveredAt  DateTime?
  returnedAt   DateTime?
  runsheet     Runsheet   @relation(fields: [runsheetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([registeredAt])
}
